    "@sanity/eslint-config-studio": "^7",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.5",
